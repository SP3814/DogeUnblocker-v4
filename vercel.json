{
  "framework": "remix",
  "cleanUrls": true,
  "routes": [
    {
      "src": "/assets/(.*)",
      "dest": "/assets/$1"
    },
    {
      "src": "/js/(.*)",
      "dest": "/js/$1"
    },
    {
      "src": "/(.*).json",
      "dest": "/$1.json"
    },
    {
      "handle": "filesystem"
    }
  ]
}
